# Binance API Credentials
# ────────────────────────────────────────────────────────────────────────
# Get testnet API keys from: https://testnet.binance.vision/
# Get live API keys from: https://www.binance.com/en/my/settings/api-management

# Testnet Futures (default for demo trading)
BINANCE_TESTNET_FUTURES_API_KEY=your_testnet_futures_api_key_here
BINANCE_TESTNET_FUTURES_API_SECRET=your_testnet_futures_api_secret_here

# Testnet Spot
BINANCE_TESTNET_SPOT_API_KEY=your_testnet_spot_api_key_here
BINANCE_TESTNET_SPOT_API_SECRET=your_testnet_spot_api_secret_here

# Live Futures (keep empty unless running live)
# BINANCE_LIVE_FUTURES_API_KEY=
# BINANCE_LIVE_FUTURES_API_SECRET=

# Live Spot (keep empty unless running live)
# BINANCE_LIVE_SPOT_API_KEY=
# BINANCE_LIVE_SPOT_API_SECRET=


# Trading Configuration
# ────────────────────────────────────────────────────────────────────────
SYMBOL=BTCUSDT
MARKET_TYPE=futures          # futures or spot
TESTNET=true                 # true for testnet, false for live
SLEEPTIME=5m                 # Loop sleep interval
LEVERAGE=1.0                 # Default leverage


# Model Configuration
# ────────────────────────────────────────────────────────────────────────
STRATEGIC_TIMEFRAME=1h
TACTICAL_TIMEFRAME=5m
STRATEGIC_DAYS=365
TACTICAL_DAYS=45
TACTICAL_ITERATIONS=300
STRATEGIC_ITERATIONS=300
MODEL_TYPE=cat               # cat or xgb


# Simulation Configuration
# ────────────────────────────────────────────────────────────────────────
SIMULATION_FEE=0.0004
SIMULATION_SLIPPAGE=0.0003
INITIAL_EQUITY=1.0
WALKFORWARD_RETRAIN_EVERY=100


# Paths
# ────────────────────────────────────────────────────────────────────────
MODEL_DIR=models
LABEL_DIR=labeleddata
LOG_DIR=logs
DATA_DIR=data
CACHE_DIR=cache


# Logging
# ────────────────────────────────────────────────────────────────────────
CONSOLE_LOG_LEVEL=INFO
FILE_LOG_LEVEL=DEBUG